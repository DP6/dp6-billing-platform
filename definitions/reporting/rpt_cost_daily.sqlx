config {
  type: "view",
  schema: dataform.projectConfig.vars.reporting_dataset,
  tags: ["billing_platform"],
  description: "Serie diaria nucleo. Serve VG (tendencia, top servicos), Tendencia (API rola p/ mes), Servicos & SKUs, Anomalias (sparkline/drill). A media movel 7d a API calcula sobre o recorte filtrado."
}

SELECT
  usage_date,
  invoice_month,
  invoice_month_date,
  service_description,
  sku_description,
  pricing_unit,
  cost_type,
  label_environment,
  label_app,
  SUM(gross_cost_brl)              AS gross_cost_brl,
  SUM(credits_total_brl)           AS credits_total_brl,
  SUM(net_cost_brl)               AS net_cost_brl,
  SUM(gross_cost_usd)            AS gross_cost_usd,
  SUM(net_cost_usd)             AS net_cost_usd,
  SUM(usage_amount_pricing_units) AS usage_amount_pricing_units,
  SUM(line_count)                AS line_count
FROM ${ref("fct_billing_cost_daily")}
GROUP BY 1,2,3,4,5,6,7,8,9
