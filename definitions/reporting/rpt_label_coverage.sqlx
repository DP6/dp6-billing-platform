config {
  type: "view",
  schema: dataform.projectConfig.vars.reporting_dataset,
  tags: ["billing_platform"],
  description: "Cobertura de label por invoice_month (fracao do custo liquido com cada chave preenchida). Serve os donuts da aba Alocacao."
}

SELECT
  invoice_month,
  SUM(net_cost_brl)                                                     AS net_cost_total_brl,
  SUM(IF(label_environment IS NOT NULL, net_cost_brl, 0))               AS net_cost_with_environment_brl,
  SUM(IF(label_app IS NOT NULL, net_cost_brl, 0))                       AS net_cost_with_app_brl,
  SUM(IF(label_managed_by IS NOT NULL, net_cost_brl, 0))               AS net_cost_with_managed_by_brl,
  SAFE_DIVIDE(SUM(IF(label_environment IS NOT NULL, net_cost_brl, 0)), NULLIF(SUM(net_cost_brl), 0)) AS pct_environment,
  SAFE_DIVIDE(SUM(IF(label_app IS NOT NULL, net_cost_brl, 0)),         NULLIF(SUM(net_cost_brl), 0)) AS pct_app,
  SAFE_DIVIDE(SUM(IF(label_managed_by IS NOT NULL, net_cost_brl, 0)),  NULLIF(SUM(net_cost_brl), 0)) AS pct_managed_by,
  SUM(IF(label_app IS NULL AND label_environment IS NULL, net_cost_brl, 0)) AS unallocated_net_cost_brl
FROM ${ref("fct_billing_cost_daily")}
GROUP BY invoice_month
