config {
  type: "view",
  schema: dataform.projectConfig.vars.reporting_dataset,
  tags: ["billing_platform"],
  description: "1 linha: custos unitarios (30 dias), conta inteira. cost_per_deploy usa DEPLOY_COUNT_PER_MONTH, que e um placeholder do polaris-cost-model e NAO faz sentido pra conta inteira (ver TODO em includes/constants.js) — cost_per_deploy desta view deve ser tratado como invalido ate essa constante ser revista. Sem project_id de proposito — e um card de 1 linha."
}

js { const c = require("includes/constants"); }

WITH w AS (
  SELECT *
  FROM ${ref("fct_billing_cost_daily")}
  WHERE usage_date >= DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.timezone}'), INTERVAL 30 DAY)
),
sku AS (
  -- 'CPU Allocation Time'/'Memory Allocation Time' (nomes usados ate 2026-09-13) nunca
  -- batiam com o billing export real do Cloud Run — os SKUs de verdade sao varios, por
  -- modo de cobranca e regiao ("Services CPU (Instance-based billing) in us-central1",
  -- "Services CPU (Request-based billing)", "Jobs CPU in us-central1", "...Tier 2...",
  -- "...Min Instance...", idem pra Memory) — por isso cost_per_vcpu_s_brl/cost_per_gib_s_brl/
  -- cpu_mem_ratio sempre vinham NULL com dado real, mesmo com uso de verdade no Cloud Run.
  -- LIKE '%CPU%'/'%Memory%' (sempre 'second'/'gibibyte second' como unidade, confirmado
  -- contra o export real) cobre todas as variantes; escopado a service_description='Cloud Run'
  -- pra nao pegar CPU/Memory de outro servico.
  SELECT
    SUM(IF(service_description = 'Cloud Run' AND sku_description = 'Requests', net_cost_brl, 0))              AS req_cost_brl,
    SUM(IF(service_description = 'Cloud Run' AND sku_description = 'Requests', usage_amount_pricing_units, 0)) AS req_units,
    SUM(IF(sku_description LIKE '%Log Storage%' OR service_description = 'Cloud Logging', net_cost_brl, 0))              AS log_cost_brl,
    SUM(IF(sku_description LIKE '%Log Storage%' OR service_description = 'Cloud Logging', usage_amount_pricing_units, 0)) AS log_units,
    SUM(IF(service_description = 'Cloud Run' AND sku_description LIKE '%CPU%', net_cost_brl, 0))              AS cpu_cost_brl,
    SUM(IF(service_description = 'Cloud Run' AND sku_description LIKE '%CPU%', usage_amount_pricing_units, 0)) AS cpu_units,
    SUM(IF(service_description = 'Cloud Run' AND sku_description LIKE '%Memory%', net_cost_brl, 0))              AS mem_cost_brl,
    SUM(IF(service_description = 'Cloud Run' AND sku_description LIKE '%Memory%', usage_amount_pricing_units, 0)) AS mem_units,
    SUM(net_cost_brl) AS total_net_brl
  FROM w
)

SELECT
  ${c.DEPLOY_COUNT_PER_MONTH}                                        AS deploy_count,
  SAFE_DIVIDE(sku.total_net_brl, ${c.DEPLOY_COUNT_PER_MONTH})        AS cost_per_deploy_brl,
  SAFE_DIVIDE(sku.req_cost_brl, NULLIF(sku.req_units, 0)) * 1000     AS cost_per_1k_req_brl,
  SAFE_DIVIDE(sku.log_cost_brl, NULLIF(sku.log_units, 0))           AS cost_per_gib_log_brl,
  SAFE_DIVIDE(sku.total_net_brl, 30)                                AS cost_per_day_avg_30d_brl,
  SAFE_DIVIDE(sku.cpu_cost_brl, NULLIF(sku.cpu_units, 0))          AS cost_per_vcpu_s_brl,
  SAFE_DIVIDE(sku.mem_cost_brl, NULLIF(sku.mem_units, 0))          AS cost_per_gib_s_brl,
  CONCAT(
    CAST(ROUND(100 * SAFE_DIVIDE(sku.cpu_cost_brl, NULLIF(sku.cpu_cost_brl + sku.mem_cost_brl, 0))) AS STRING),
    ' : ',
    CAST(ROUND(100 * SAFE_DIVIDE(sku.mem_cost_brl, NULLIF(sku.cpu_cost_brl + sku.mem_cost_brl, 0))) AS STRING)
  )                                                                 AS cpu_mem_ratio
FROM sku
