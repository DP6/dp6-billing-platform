config {
  type: "view",
  schema: dataform.projectConfig.vars.reporting_dataset,
  tags: ["billing_platform"],
  description: "1 linha: custos unitarios (30 dias). cost_per_deploy usa deploy_count de config (specs/003 decisao #3 — nao esta no billing export)."
}

js { const c = require("includes/constants"); }

WITH w AS (
  SELECT *
  FROM ${ref("fct_billing_cost_daily")}
  WHERE usage_date >= DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.timezone}'), INTERVAL 30 DAY)
),
sku AS (
  SELECT
    SUM(IF(sku_description = 'Requests', net_cost_brl, 0))              AS req_cost_brl,
    SUM(IF(sku_description = 'Requests', usage_amount_pricing_units, 0)) AS req_units,
    SUM(IF(sku_description LIKE '%Log Storage%' OR service_description = 'Cloud Logging', net_cost_brl, 0))              AS log_cost_brl,
    SUM(IF(sku_description LIKE '%Log Storage%' OR service_description = 'Cloud Logging', usage_amount_pricing_units, 0)) AS log_units,
    SUM(IF(sku_description = 'CPU Allocation Time', net_cost_brl, 0))              AS cpu_cost_brl,
    SUM(IF(sku_description = 'CPU Allocation Time', usage_amount_pricing_units, 0)) AS cpu_units,
    SUM(IF(sku_description = 'Memory Allocation Time', net_cost_brl, 0))              AS mem_cost_brl,
    SUM(IF(sku_description = 'Memory Allocation Time', usage_amount_pricing_units, 0)) AS mem_units,
    SUM(net_cost_brl) AS total_net_brl
  FROM w
)

SELECT
  ${c.DEPLOY_COUNT_PER_MONTH}                                        AS deploy_count,
  SAFE_DIVIDE(sku.total_net_brl, ${c.DEPLOY_COUNT_PER_MONTH})        AS cost_per_deploy_brl,
  SAFE_DIVIDE(sku.req_cost_brl, NULLIF(sku.req_units, 0)) * 1000     AS cost_per_1k_req_brl,
  SAFE_DIVIDE(sku.log_cost_brl, NULLIF(sku.log_units, 0))           AS cost_per_gib_log_brl,
  SAFE_DIVIDE(sku.total_net_brl, 30)                                AS cost_per_day_avg_30d_brl,
  SAFE_DIVIDE(sku.cpu_cost_brl, NULLIF(sku.cpu_units, 0))          AS cost_per_vcpu_s_brl,
  SAFE_DIVIDE(sku.mem_cost_brl, NULLIF(sku.mem_units, 0))          AS cost_per_gib_s_brl,
  CONCAT(
    CAST(ROUND(100 * SAFE_DIVIDE(sku.cpu_cost_brl, NULLIF(sku.cpu_cost_brl + sku.mem_cost_brl, 0))) AS STRING),
    ' : ',
    CAST(ROUND(100 * SAFE_DIVIDE(sku.mem_cost_brl, NULLIF(sku.cpu_cost_brl + sku.mem_cost_brl, 0))) AS STRING)
  )                                                                 AS cpu_mem_ratio
FROM sku
